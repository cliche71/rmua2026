<launch>
  <arg name="mav_name" default="drone_1"/>
  <arg name="slam_source" default="vio"/>

  <!-- <node name="call_reset_service" pkg="rosservice" type="rosservice" args="call /airsim_node/reset"/> -->

  <group if="$(eval arg('slam_source') == 'lio')">
    <include file="$(find fast_lio)/launch/mapping_mid360.launch">
      <arg name="rviz" value="true"/>
    </include>
  </group>

  <group if="$(eval arg('slam_source') == 'vio')">
    <node name="vins_fusion" pkg="vins" type="vins_node" output="screen" args="$(find vins)/../config/rmua.yaml"/>
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen" args="-d $(find vins)/../config/vins_rviz_config.rviz"/>
  </group>
  <!-- <node name="basic_dev" pkg="basic_dev"  type="basic_dev" output="log"/> -->


  <node name="lee_position_controller_node" pkg="rotors_control" type="lee_position_controller_node" output="screen">
    <rosparam command="load" file="$(find rotors_control)/resource/lee_controller_$(arg mav_name).yaml" />
    <rosparam command="load" file="$(find rotors_control)/resource/$(arg mav_name).yaml" />
  </node>

  <node name="imu_gps_odometry" pkg="imu_gps_odometry" type="imu_gps_odometry" output="screen">
    <param name="slam_source" value="$(arg slam_source)"/>
  </node>
  <node name="hovering_example" pkg="rotors_control" type="hovering_example" output="screen"/>
</launch>
