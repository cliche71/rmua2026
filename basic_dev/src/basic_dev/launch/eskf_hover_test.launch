<launch>
  <arg name="mav_name" default="drone_1"/>

  <arg name="lee_controller_yaml"
       default="$(find rotors_control)/resource/lee_controller_drone_1_eskf.yaml"/>

  <arg name="odometry_topic" default="/eskf_odom"/>
  <arg name="initial_pose_topic" default="/airsim_node/initial_pose"/>
  <arg name="motor_topic"
       default="/airsim_node/$(arg mav_name)/rotor_pwm_cmd"/>

  <!-- 与当前 ESKF 保守测试保持一致 -->
  <arg name="max_rotor_pwm" default="0.42"/>
  <arg name="enable_pwm_desaturation" default="false"/>
  <arg name="max_tilt_angle_deg" default="18.0"/>

  <!-- GPS + IMU -> /eskf_odom -->
  <node name="imu_gps_odometry"
        pkg="imu_gps_odometry"
        type="imu_gps_odometry"
        output="screen">

    <param name="gps_message_type" value="pose"/>
    <param name="use_gps_orientation" value="false"/>
    <param name="use_gps_z_anchor" value="false"/>
    <param name="use_receive_time_for_imu_dt" value="true"/>
    <param name="initialize_position_from_first_gps" value="true"/>
    <param name="enable_accel_model_diagnostics" value="true"/>

    <param name="odom_topic" value="$(arg odometry_topic)"/>
    <param name="gps_topic"
           value="/airsim_node/$(arg mav_name)/gps"/>
    <param name="imu_topic"
           value="/airsim_node/$(arg mav_name)/imu/imu"/>
    <param name="initial_pose_topic"
           value="$(arg initial_pose_topic)"/>

    <param name="pos_noise" value="0.5"/>
    <param name="vel_noise" value="0.5"/>
    <param name="gps_position_std" value="0.3"/>
  </node>

  <!-- ESKF odometry -> Lee -> AirSim PWM -->
  <node name="lee_position_controller_node"
        pkg="rotors_control"
        type="lee_position_controller_node"
        output="screen">

    <rosparam command="load" file="$(arg lee_controller_yaml)"/>
    <rosparam command="load"
              file="$(find rotors_control)/resource/$(arg mav_name).yaml"/>

    <param name="command_trajectory_topic"
           value="/command/trajectory"/>
    <param name="odometry_topic"
           value="$(arg odometry_topic)"/>
    <param name="initial_pose_topic"
           value="$(arg initial_pose_topic)"/>
    <param name="motor_topic"
           value="$(arg motor_topic)"/>

    <!-- 必须与稳定 gate_pipeline 一致 -->
    <param name="odometry_velocity_in_body_frame" value="false"/>
    <param name="use_airsim_frame_adapter" value="true"/>
    <param name="use_airsim_pwm_mixer" value="true"/>

    <param name="max_rotor_pwm" value="$(arg max_rotor_pwm)"/>
    <param name="enable_pwm_desaturation"
           value="$(arg enable_pwm_desaturation)"/>
    <param name="max_tilt_angle_deg"
           value="$(arg max_tilt_angle_deg)"/>

    <!-- 当前只验证基础 ESKF 闭环 -->
    <param name="enable_disturbance_observer" value="false"/>
    <param name="enable_attitude_disturbance_observer" value="false"/>
  </node>
</launch>
