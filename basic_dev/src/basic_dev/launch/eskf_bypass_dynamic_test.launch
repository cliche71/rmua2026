<launch>
  <arg name="mav_name" default="drone_1"/>

  <!-- 使用已经验证稳定的普通 Lee 参数 -->
  <arg name="lee_controller_yaml"
       default="$(find rotors_control)/resource/lee_controller_drone_1.yaml"/>

  <arg name="truth_pose_topic"
       default="/airsim_node/drone_1/debug/pose_gt"/>

  <arg name="truth_odom_topic"
       default="/se3_truth_odom"/>

  <arg name="eskf_odom_topic"
       default="/eskf_odom"/>

  <!-- pose_gt -> truth odometry，专门提供给 Lee -->
  <node name="pose_to_odom"
        pkg="basic_dev"
        type="pose_to_odom.py"
        output="screen">

    <param name="pose_topic"
           value="$(arg truth_pose_topic)"/>

    <param name="odom_topic"
           value="$(arg truth_odom_topic)"/>

    <param name="child_frame_id"
           value="$(arg mav_name)"/>

    <param name="min_dt"
           value="0.005"/>

    <param name="max_dt"
           value="0.05"/>

    <param name="linear_velocity_cutoff_hz"
           value="8.0"/>

    <param name="angular_velocity_cutoff_hz"
           value="10.0"/>

    <param name="max_linear_velocity"
           value="3.0"/>

    <param name="max_linear_acceleration"
           value="100.0"/>

    <param name="max_angular_velocity"
           value="8.0"/>

    <param name="reset_after_invalid_count"
           value="5"/>

    <param name="diagnostics_period"
           value="1.0"/>
  </node>

  <!-- ESKF 旁路运行，只发布 /eskf_odom -->
  <node name="imu_gps_odometry"
        pkg="imu_gps_odometry"
        type="imu_gps_odometry"
        output="screen">

    <param name="odom_topic"
           value="$(arg eskf_odom_topic)"/>

    <param name="gps_topic"
           value="/airsim_node/drone_1/gps"/>

    <param name="imu_topic"
           value="/airsim_node/drone_1/imu/imu"/>

    <param name="initial_pose_topic"
           value="/airsim_node/initial_pose"/>

    <param name="use_gps_orientation"
           value="false"/>

    <param name="use_gps_z_anchor"
           value="false"/>

    <param name="use_receive_time_for_imu_dt"
           value="true"/>

    <param name="initialize_position_from_first_gps"
           value="true"/>

    <param name="pos_noise"
           value="0.5"/>

    <param name="vel_noise"
           value="0.5"/>

    <param name="gps_position_std"
           value="0.3"/>

    <param name="imu_gyro_noise_density"
           value="0.00143"/>

    <param name="imu_acc_noise_density"
           value="0.0386"/>
  </node>

  <!-- Lee 只读取 truth odometry，不读取 ESKF -->
  <node name="lee_position_controller_node"
        pkg="rotors_control"
        type="lee_position_controller_node"
        output="screen">

    <rosparam command="load"
              file="$(arg lee_controller_yaml)"/>

    <rosparam command="load"
              file="$(find rotors_control)/resource/$(arg mav_name).yaml"/>

    <param name="odometry_topic"
           value="$(arg truth_odom_topic)"/>

    <param name="command_trajectory_topic"
           value="/command/trajectory"/>

    <param name="initial_pose_topic"
           value="/airsim_node/initial_pose"/>

    <param name="motor_topic"
           value="/airsim_node/$(arg mav_name)/rotor_pwm_cmd"/>

    <param name="odometry_velocity_in_body_frame"
           value="false"/>

    <param name="use_airsim_frame_adapter"
           value="true"/>

    <param name="use_airsim_pwm_mixer"
           value="true"/>

    <!-- 限制动作幅度，降低测试风险 -->
    <param name="max_tilt_angle_deg"
           value="12.0"/>

    <param name="max_rotor_pwm"
           value="0.35"/>

    <!-- 旁路测试先关闭 ESO -->
    <param name="enable_disturbance_observer"
           value="false"/>

    <param name="enable_attitude_disturbance_observer"
           value="false"/>
  </node>
</launch>
